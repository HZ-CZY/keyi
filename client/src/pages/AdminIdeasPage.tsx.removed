import { useEffect, useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { api } from '../lib/api';
import { useAuth } from '../context/AuthContext';
import { Lightbulb, Check, X, Loader2, RefreshCw } from 'lucide-react';

interface Idea {
  id: number;
  user_id: number;
  username: string | null;
  content: string;
  status: 'pending' | 'accepted' | 'rejected';
  reward: number;
  created_at: number;
  reviewed_at: number | null;
}

const STATUS_META: Record<string, { label: string; cls: string }> = {
  pending: { label: '待处理', cls: 'bg-amber-100 text-amber-700' },
  accepted: { label: '已采纳', cls: 'bg-emerald-100 text-emerald-700' },
  rejected: { label: '已拒绝', cls: 'bg-gray-200 text-gray-600' },
};

const FILTERS: { key: 'pending' | 'accepted' | 'rejected' | 'all'; label: string }[] = [
  { key: 'pending', label: '待处理' },
  { key: 'accepted', label: '已采纳' },
  { key: 'rejected', label: '已拒绝' },
  { key: 'all', label: '全部' },
];

/**
 * 后台 · 想法征集
 * ─────────────────────────────────────────────────────────
 * 学生在「实词大赛排行榜」下方提交的想法。
 * 管理员点「采纳」即发放 300 铜板（后端 addCoins 记账，可对账）；
 * 拒绝则仅改状态，不发奖。
 */
export default function AdminIdeasPage() {
  const { user } = useAuth();
  const navigate = useNavigate();
  const [rows, setRows] = useState<Idea[]>([]);
  const [loading, setLoading] = useState(true);
  const [busy, setBusy] = useState<number | null>(null);
  const [filter, setFilter] = useState<'pending' | 'accepted' | 'rejected' | 'all'>('pending');

  const load = () => {
    setLoading(true);
    api.suggestions
      .adminList()
      .then((d) => setRows(d as Idea[]))
      .catch(() => setRows([]))
      .finally(() => setLoading(false));
  };

  useEffect(() => {
    if (user?.role !== 'admin') {
      navigate('/');
      return;
    }
    load();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [user, navigate]);

  const act = async (id: number, kind: 'accept' | 'reject') => {
    if (busy) return;
    setBusy(id);
    try {
      if (kind === 'accept') await api.suggestions.accept(id);
      else await api.suggestions.reject(id);
      await load();
    } catch (e: any) {
      alert(e?.message || '操作失败');
    } finally {
      setBusy(null);
    }
  };

  const list = filter === 'all' ? rows : rows.filter((r) => r.status === filter);
  const pendingCount = rows.filter((r) => r.status === 'pending').length;

  return (
    <div className="space-y-4">
      <div className="flex items-start justify-between gap-3">
        <div>
          <h1 className="text-2xl font-bold text-gray-900 flex items-center gap-2">
            <Lightbulb className="w-6 h-6 text-amber-500" /> 想法征集
          </h1>
          <p className="text-sm text-gray-500 mt-1">
            学生在实词大赛排行榜下提交的想法。采纳后自动发放 <b>300 铜板</b>，并记入铜板流水。
          </p>
        </div>
        <button
          onClick={load}
          className="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 rounded-xl text-sm font-medium text-gray-700 bg-white/70 hover:bg-white shadow-sm transition"
        >
          <RefreshCw className={`w-4 h-4 ${loading ? 'animate-spin' : ''}`} /> 刷新
        </button>
      </div>

      <div className="flex items-center gap-2 flex-wrap">
        {FILTERS.map((f) => (
          <button
            key={f.key}
            onClick={() => setFilter(f.key)}
            className={`px-3.5 py-1.5 rounded-full text-sm font-medium transition ${
              filter === f.key ? 'bg-gray-900 text-white' : 'bg-white/70 text-gray-600 hover:bg-white'
            }`}
          >
            {f.label}
            {f.key === 'pending' && pendingCount > 0 && (
              <span className="ml-1.5 text-[11px] px-1.5 py-0.5 rounded-full bg-amber-500 text-white">{pendingCount}</span>
            )}
          </button>
        ))}
      </div>

      <div className="glass rounded-3xl shadow-soft-lg p-5">
        {loading ? (
          <div className="py-12 text-center text-gray-400 flex items-center justify-center gap-2">
            <Loader2 className="w-5 h-5 animate-spin" /> 加载中…
          </div>
        ) : list.length === 0 ? (
          <div className="py-12 text-center text-gray-400">暂无想法</div>
        ) : (
          <ul className="space-y-3">
            {list.map((r) => {
              const meta = STATUS_META[r.status] || STATUS_META.pending;
              return (
                <li key={r.id} className="rounded-2xl bg-white/70 p-4 shadow-sm">
                  <div className="flex items-center gap-2 flex-wrap mb-2">
                    <span className="font-semibold text-gray-900">{r.username || `用户 #${r.user_id}`}</span>
                    <span className={`text-[11px] px-2 py-0.5 rounded-full font-medium ${meta.cls}`}>{meta.label}</span>
                    {r.status === 'accepted' && (
                      <span className="text-[11px] px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 font-medium">
                        +{r.reward} 铜板
                      </span>
                    )}
                    <span className="ml-auto text-xs text-gray-400">
                      {new Date(r.created_at * 1000).toLocaleString('zh-CN')}
                    </span>
                  </div>
                  <p className="text-[15px] leading-7 text-gray-800 whitespace-pre-wrap break-words">{r.content}</p>
                  {r.status === 'pending' && (
                    <div className="mt-3 flex items-center gap-2">
                      <button
                        disabled={busy === r.id}
                        onClick={() => act(r.id, 'accept')}
                        className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-sm font-semibold text-white bg-emerald-600 hover:bg-emerald-700 disabled:opacity-50 transition"
                      >
                        <Check className="w-4 h-4" /> 采纳并奖励 300 铜板
                      </button>
                      <button
                        disabled={busy === r.id}
                        onClick={() => act(r.id, 'reject')}
                        className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-sm font-medium text-gray-600 bg-white hover:bg-gray-50 shadow-sm disabled:opacity-50 transition"
                      >
                        <X className="w-4 h-4" /> 拒绝
                      </button>
                      {busy === r.id && <Loader2 className="w-4 h-4 animate-spin text-gray-400" />}
                    </div>
                  )}
                </li>
              );
            })}
          </ul>
        )}
      </div>
    </div>
  );
}
