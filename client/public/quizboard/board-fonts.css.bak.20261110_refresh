/* SVG 公式缩放后仍保留小数字形度量，避免长 label 收纳时重新取整而挤压下划线。 */
svg text[data-variant="-explicitFont"] { text-rendering: geometricPrecision; }
/* WebKit 的 geometricPrecision 会对 size-adjust 字体重复缩放，保留其默认 SVG 度量。 */
@supports (-webkit-touch-callout: none) {
  :lang(en) svg text[data-variant="-explicitFont"] { text-rendering: auto; }
}

/* 以小写字高对齐 Minion Pro：43.8 / 52.1 ≈ 84%，统一缩放字形和排版测量。 */
@font-face {
  font-family: "Board Merriweather";
  font-style: normal;
  font-weight: 300 900;
  font-display: swap;
  src: url("/quizboard/fonts/Merriweather-VF.woff2") format("woff2");
  size-adjust: 84%;
  font-variation-settings: "opsz" 18;
}

@font-face {
  font-family: "Board Merriweather";
  font-style: italic;
  font-weight: 300 900;
  font-display: swap;
  src: url("/quizboard/fonts/Merriweather-Italic-VF.woff2") format("woff2");
  size-adjust: 84%;
  font-variation-settings: "opsz" 18;
}

/* 保留思源黑体资源供其他页面使用，讲解正文及卡片标题统一沿用思源宋体。 */
@font-face {
  font-family: "Source Han Sans CN";
  font-style: normal;
  font-weight: 250 900;
  font-display: swap;
  src: url("/quizboard/fonts/SourceHanSansCN-VF.woff2") format("woff2");
}

/* 思源宋体只覆盖中文字形与中式标点，拉丁字母和数字按语言选择字体。 */
@font-face {
  font-family: "Source Han Serif CN";
  font-style: normal;
  font-weight: 200 900;
  font-display: swap;
  src: url("/quizboard/fonts/SourceHanSerifCN-VF.woff2") format("woff2");
  unicode-range: U+2E80-2FDF, U+3000-303F, U+3100-312F, U+31A0-31BF, U+31C0-31EF, U+3400-4DBF, U+4E00-9FFF, U+F900-FAFF, U+FE10-FE1F, U+FE30-FE4F, U+FF00-FFEF, U+20000-2FFFF, U+30000-323AF;
}

/* 复用完整思源宋体作为公式补字字体；放在西文字体之后，不替换已有拉丁字形。 */
@font-face {
  font-family: "Board Symbol Fallback";
  font-style: normal;
  font-weight: 200 900;
  font-display: swap;
  src: url("/quizboard/fonts/SourceHanSerifCN-VF.woff2") format("woff2");
}

/* 思源宋体也缺少的数学符号由随包分发的 STIX Two Math 补齐。 */
@font-face {
  font-family: "Board Math Fallback";
  font-style: normal;
  font-weight: 400;
  font-display: swap;
  src: url("/quizboard/fonts/STIXTwoMath-Regular.woff2") format("woff2");
}

/* 正文与公式里的西文、数字、希腊字母：STIX Two Text，与公式结构字体 STIX Two Math（MathJax mathjax-stix2）同一设计
   （2026-10-01 用户定：标题无衬线、正文衬线，选适合数学的字体）。它不含箭头与运算符，这些由其后的 STIX Two Math 补齐。 */
@font-face {
  font-family: "Board STIX Two Text";
  font-style: normal;
  font-weight: 400 700;
  font-display: swap;
  src: url("/quizboard/fonts/STIXTwoText-VF.woff2") format("woff2");
}

