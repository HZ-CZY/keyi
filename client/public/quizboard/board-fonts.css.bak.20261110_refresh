:root {
  --board-font-cjk: "Source Han Serif CN";
  --board-font-comic: "Comic Shanns", "Comic Shanns Mono";
  --board-font-yozai: "Yozai";
  --board-font-wenkai: "LXGW WenKai";
  --board-font-sans: var(--board-font-cjk), var(--board-font-wenkai), var(--board-font-comic), "BoardFira", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --board-font-hand: var(--board-font-cjk), var(--board-font-wenkai), var(--board-font-comic), "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

/* 中英文教学内容的西文统一用 STIX Two Text；箭头、运算符先取 STIX Two Math，思源宋体全字符集最后补字
   （此前 → 落到思源宋体的全角箭头上，又小又低）。 */
:root:lang(en),
:root:lang(zh) {
  --board-font-wenkai: "Board STIX Two Text", "Board Math Fallback", "LXGW WenKai";
  --board-font-comic: "Board STIX Two Text", "Board Math Fallback", "Comic Shanns", "Comic Shanns Mono";
  --board-font-yozai: "Board STIX Two Text", "Board Math Fallback", "Yozai";
}

/* 独立保留原文楷方案，覆盖语言分支，避免被新版中西文字体优先级覆盖。 */
:root[data-font-preset="wenkai"] {
  --board-font-cjk: "LXGW WenKai";
  --board-font-wenkai: "LXGW WenKai";
  --board-font-comic: "Comic Shanns", "Comic Shanns Mono";
  --board-font-yozai: "Yozai";
  --board-font-sans: var(--board-font-wenkai), var(--board-font-comic), "BoardFira", "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --board-font-hand: var(--board-font-wenkai), var(--board-font-comic), "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  --board-formula-scale: 1.05em;
}
